{
  "name": "gestionale-bollette",
  "version": "0.0.0",
  "description": "Gestionale per la ripartizione delle bollette tra proprietario e inquilini",
  "author": "Gestionale Bollette",
  "main": "electron/main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "electron": "ng build && electron .",
    "electron:run": "electron .",
    "dist:win": "ng build && electron-builder --win"
  },
  "build": {
    "appId": "it.locuratolo.gestionalebollette",
    "productName": "Gestionale Bollette",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "dist/gestionale-bollette/browser/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] },
        { "target": "portable", "arch": ["x64"] }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "GestionaleBollette-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "GestionaleBollette-Portable-${version}.${ext}"
    }
  },
  "private": true,
  "packageManager": "npm@10.9.0",
  "dependencies": {
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@tailwindcss/postcss": "^4.3.5",
    "pdfjs-dist": "^6.5.438",
    "postcss": "^8.5.32",
    "rxjs": "~7.8.0",
    "tailwindcss": "^4.3.5",
    "tesseract.js": "^5.1.1",
    "tslib": "^2.3.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@angular/build": "^21.2.17",
    "@angular/cli": "^21.2.17",
    "@angular/compiler-cli": "^21.2.0",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "vitest": "^4.0.8"
  }
}
